# ─── App ──────────────────────────────────────────────────────────────────────

# URL of the budget-api backend (trailing slash required)
VITE_API_URL=http://localhost:8000/

# Storage adapter. Only "localStorage" is supported.
VITE_STORAGE_TYPE=localStorage

# ─── Deployment (node deploy.mjs) ─────────────────────────────────────────────

# SSH target for rsync-based release deploys
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_BASE=/var/www/app-v2
DEPLOY_KEEP=5

# ─── Static Analysis (optional) ───────────────────────────────────────────────

# SonarQube token for `pnpm sonar:scan`
SONAR_USER_TOKEN=

# Dev server port override (optional, default: 5173)
# HOST_PORT=5173
